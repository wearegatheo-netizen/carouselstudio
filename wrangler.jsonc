{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carouselstudio",
  "compatibility_date": "2026-09-21",
  "observability": { "enabled": true },
  // 정적 에셋은 dist/ 만 배포 (node_modules·src 제외)
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash", "not_found_handling": "single-page-application" }
}
